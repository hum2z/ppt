# Copy to .env and fill in. The app reads these at startup.

# Required: your Claude API key (used to write the new slide content).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use (default: claude-sonnet-4-6).
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: server host/port.
# HOST=0.0.0.0
# PORT=8000

# Optional: max upload size in bytes (default: 25 MB).
# MAX_UPLOAD_BYTES=26214400
